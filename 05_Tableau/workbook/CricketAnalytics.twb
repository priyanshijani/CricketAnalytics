    <worksheet name="KPI Trend Close">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Match" name='federated.match' />
          </datasources>
          <datasource-dependencies datasource='federated.match'>
            <column caption="Close finishes" datatype='real' default-format="p0%" name="[Calc_ClosePct]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="AVG([Calc_CloseFinish])" />
            </column>
            <column caption="Close finish" datatype='integer' name="[Calc_CloseFinish]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="IF [ResultMethod] = 'Tied' OR [ResultMethod] = 'SuperOver' THEN 1 ELSEIF [ResultMethod] = 'Normal' THEN (IF ([WinMarginType] = 'Runs' AND [WinMargin] &lt;= 10) OR ([WinMarginType] = 'Wickets' AND [WinMargin] &lt;= 2) THEN 1 ELSE 0 END) END" />
            </column>
            <column-instance column="[Calc_ClosePct]" derivation='User' name="[usr:Calc_ClosePct:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_CloseFinish]" derivation='Sum' name="[sum:Calc_CloseFinish:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_CloseFinish]" derivation='Count' name="[cnt:Calc_CloseFinish:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.match].[usr:Calc_ClosePct:qk]' value="p0%" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.match].[usr:Calc_ClosePct:qk]' />
              <text column='[federated.match].[sum:Calc_CloseFinish:qk]' />
              <text column='[federated.match].[cnt:Calc_CloseFinish:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='9'>Close finishes&#10;</run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='22'>&lt;[federated.match].[usr:Calc_ClosePct:qk]&gt;</run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'>&#10;≤10 runs/≤2 wkts: </run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'>&lt;[federated.match].[sum:Calc_CloseFinish:qk]&gt;</run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'> of </run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'>&lt;[federated.match].[cnt:Calc_CloseFinish:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{28F1BEBF-4766-547C-8DAB-61F7B2C332CB}' />
    </worksheet>
    <worksheet name="Insight Trends Toss">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Match" name='federated.match' />
          </datasources>
          <datasource-dependencies datasource='federated.match'>
            <column caption="Toss winner won" datatype='integer' default-format="p0%" name="[TossWinnerWonMatch]" role='measure' type='quantitative' />
            <column caption="Team batting first won" datatype='integer' default-format="p0%" name="[BattingFirstWon]" role='measure' type='quantitative' />
            <column caption="Chance range (± points, 95%)" datatype='real' default-format="n#,##0" name="[Calc_ChanceRange]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="100 * 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch]))" />
            </column>
            <column caption="Verdict" datatype='string' name="[Calc_TossVerdict]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF ABS(AVG([TossWinnerWonMatch]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch])) AND ABS(AVG([BattingFirstWon]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([BattingFirstWon])) THEN 'both are real edges at this sample size' ELSEIF ABS(AVG([TossWinnerWonMatch]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch])) THEN 'winning the toss is a real edge; batting first is not' ELSEIF ABS(AVG([BattingFirstWon]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([BattingFirstWon])) THEN 'batting first is a real edge; the toss is not' ELSE 'neither is a reliable edge yet - both are within what chance alone gives' END" />
            </column>
            <column-instance column="[TossWinnerWonMatch]" derivation='Avg' name="[avg:TossWinnerWonMatch:qk]" pivot='key' type='quantitative' />
            <column-instance column="[BattingFirstWon]" derivation='Avg' name="[avg:BattingFirstWon:qk]" pivot='key' type='quantitative' />
            <column-instance column="[TossWinnerWonMatch]" derivation='Count' name="[cnt:TossWinnerWonMatch:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChanceRange]" derivation='User' name="[usr:Calc_ChanceRange:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_TossVerdict]" derivation='User' name="[usr:Calc_TossVerdict:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.match].[avg:TossWinnerWonMatch:qk]' />
              <text column='[federated.match].[avg:BattingFirstWon:qk]' />
              <text column='[federated.match].[cnt:TossWinnerWonMatch:qk]' />
              <text column='[federated.match].[usr:Calc_ChanceRange:qk]' />
              <text column='[federated.match].[usr:Calc_TossVerdict:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#F2A900' fontname='Tableau Semibold' fontsize='10'>▶ Insight   </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>All seasons: toss winners won </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.match].[avg:TossWinnerWonMatch:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> and teams batting first </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.match].[avg:BattingFirstWon:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> of </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.match].[cnt:TossWinnerWonMatch:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> matches (chance range 50% ± </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.match].[usr:Calc_ChanceRange:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> pts), so </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.match].[usr:Calc_TossVerdict:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>. Click a venue on the right to filter the toss chart.</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{7F46EC8C-1508-51CE-9A42-3FB35666457F}' />
    </worksheet>
    <worksheet name="Result Types by Season">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>How matches were decided: share of each season</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Match" name='federated.match' />
          </datasources>
          <datasource-dependencies datasource='federated.match'>
            <column caption="Share of the season's matches" datatype='real' default-format="p0%" name="[Calc_SeasonShare]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="COUNTD([MatchId]) / MIN({FIXED [Season] : COUNTD([MatchId])})" />
            </column>
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="Result type" datatype='string' name="[Calc_ResultType]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [ResultMethod] = 'Normal' THEN 'Won by ' + LOWER([WinMarginType]) ELSE [ResultMethod] END" />
            </column>
            <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
            <column-instance column="[Calc_SeasonShare]" derivation='User' name="[usr:Calc_SeasonShare:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_ResultType]" derivation='None' name="[none:Calc_ResultType:nk]" pivot='key' type='nominal' />
            <column-instance column="[MatchId]" derivation='CountD' name="[ctd:MatchId:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
