        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.playercareer].[none:PlayerName:nk]' />
              <text column='[federated.playercareer].[none:PlayerRole:nk]' />
              <text column='[federated.playercareer].[avg:ImpactPerMatch:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#F2A900' fontname='Tableau Semibold' fontsize='10'>▶ Insight   </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>Most value per match: </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playercareer].[none:PlayerName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> (</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.playercareer].[none:PlayerRole:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>), </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playercareer].[avg:ImpactPerMatch:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> impact points per match (runs + 20 per wicket). </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>Click any player to pick them, then open the profile with the button.</run>
