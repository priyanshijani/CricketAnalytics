    <datasource caption="DQ Row Outcome" inline='true' name='federated.dqrowoutcome' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="DQRowOutcome" name='hyper.dqrowoutcome'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_DQRowOutcome.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.dqrowoutcome' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.dqrowoutcome' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption="DQ run" datatype='string' name="[LoadRunId]" role='dimension' type='nominal' />
      <column caption="Entity" datatype='string' name="[EntityType]" role='dimension' type='nominal' />
      <column datatype='integer' name="[OutcomeOrder]" role='dimension' type='ordinal' />
      <column caption="Outcome" datatype='string' name="[Outcome]" role='dimension' type='nominal' />
      <column datatype='integer' name="[Passed]" role='dimension' type='ordinal' />
      <column datatype='integer' name="[Rows]" role='measure' type='quantitative' />
      <column datatype='integer' name="[IsCurrent]" role='dimension' type='ordinal' />
      <column caption="Rows accepted" datatype='integer' name="[Calc_PassedRows]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [Passed] = 1 THEN [Rows] ELSE 0 END" />
      </column>
      <column caption="Rows held or rejected" datatype='integer' name="[Calc_NotPassedRows]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [Passed] = 0 THEN [Rows] ELSE 0 END" />
      </column>
      <column caption="Rows flagged" datatype='integer' name="[Calc_FlaggedRows]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [OutcomeOrder] = 5 THEN [Rows] ELSE 0 END" />
      </column>
      <column caption="% accepted" datatype='real' default-format="p0.0%" name="[Calc_AcceptedPct]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Calc_PassedRows]) / SUM([Rows])" />
      </column>
      <column caption="Rows not passed (ranking)" datatype='real' name="[Calc_RankReason]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Calc_NotPassedRows])" />
      </column>
      <column-instance column='[EntityType]' derivation='None' name='[none:EntityType:nk]' pivot='key' type='nominal' />
      <style>
