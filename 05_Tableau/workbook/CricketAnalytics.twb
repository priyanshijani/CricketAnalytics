          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.teammatch].[TeamCurrentName]' caption="Team" datatype='string' name="[Select Team]" param-domain-type='list' role='measure' type='nominal' value='"Bangalore Royals"'>
          <calculation class='tableau' formula='"Bangalore Royals"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.teamseason'>
            <column caption="Win %" datatype='real' default-format="n#,##0.0" name="[WinPct]" role='measure' type='quantitative' />
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="Team" datatype='string' name="[Calc_TeamGroup]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [TeamCurrentName] = [Parameters].[Select Team] THEN 'Selected team' ELSE 'Other teams' END" />
            </column>
            <column caption="Team" datatype='string' name="[TeamCurrentName]" role='dimension' type='nominal' />
            <column-instance column="[WinPct]" derivation='Sum' name="[sum:WinPct:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_TeamGroup]" derivation='None' name="[none:Calc_TeamGroup:nk]" pivot='key' type='nominal' />
            <column-instance column="[TeamCurrentName]" derivation='None' name="[none:TeamCurrentName:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
