    <worksheet name="Consistent vs Explosive">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Consistent vs explosive (lines = medians; left = steadier, up = faster)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Career" name='federated.playercareer' />
          </datasources>
          <datasource-dependencies datasource='federated.playercareer'>
            <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[StrikeRate]" role='measure' type='quantitative' />
            <column caption="Variation in runs per innings (CV)" datatype='real' default-format="n#,##0.00" name="[RunsVariationCoefficient]" role='measure' type='quantitative' />
            <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
            <column datatype='integer' name="[Runs]" role='measure' type='quantitative' />
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Innings batted" datatype='integer' name="[InningsBatted]" role='measure' type='quantitative' />
            <column-instance column="[StrikeRate]" derivation='Avg' name="[avg:StrikeRate:qk]" pivot='key' type='quantitative' />
            <column-instance column="[RunsVariationCoefficient]" derivation='Avg' name="[avg:RunsVariationCoefficient:qk]" pivot='key' type='quantitative' />
            <column-instance column="[PlayerRole]" derivation='None' name="[none:PlayerRole:nk]" pivot='key' type='nominal' />
            <column-instance column="[Runs]" derivation='Sum' name="[sum:Runs:qk]" pivot='key' type='quantitative' />
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[InningsBatted]" derivation='Sum' name="[sum:InningsBatted:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.playercareer].[sum:InningsBatted:qk]' included-values='in-range'>
            <min>5</min>
          </filter>
          <slices>
            <column>[federated.playercareer].[sum:InningsBatted:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
