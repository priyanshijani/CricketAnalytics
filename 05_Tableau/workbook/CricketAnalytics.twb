    <worksheet name="Leaderboard Standings">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Points Table" name='federated.pointstable' />
          </datasources>
          <datasource-dependencies datasource='federated.pointstable'>
            <column caption="Pos" datatype='string' name="[PositionLabel]" role='dimension' type='nominal' />
            <column caption="Team" datatype='string' name="[TeamCurrentName]" role='dimension' type='nominal' />
            <column caption="P" datatype='integer' name="[Played]" role='dimension' type='ordinal' />
            <column caption="W" datatype='integer' name="[Won]" role='dimension' type='ordinal' />
            <column caption="L" datatype='integer' name="[Lost]" role='dimension' type='ordinal' />
            <column caption="NR" datatype='integer' name="[NoResult]" role='dimension' type='ordinal' />
            <column caption="NRR" datatype='string' name="[NetRunRateLabel]" role='dimension' type='nominal' />
            <column caption="Form" datatype='string' name="[Calc_FormIcons]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="REPLACE(REPLACE(REPLACE(REPLACE(REPLACE([Form], ' ', ''), 'NR','⚪'), 'W', '🟢'), 'L', '🔴'), 'T', '🟡')" />
            </column>
            <column caption="Pts" datatype='integer' name="[Points]" role='measure' type='quantitative' />
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column datatype='integer' name="[Position]" role='measure' type='quantitative' />
            <column-instance column="[PositionLabel]" derivation='None' name="[none:PositionLabel:nk]" pivot='key' type='nominal' />
            <column-instance column="[TeamCurrentName]" derivation='None' name="[none:TeamCurrentName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Played]" derivation='None' name="[none:Played:ok]" pivot='key' type='ordinal' />
            <column-instance column="[Won]" derivation='None' name="[none:Won:ok]" pivot='key' type='ordinal' />
            <column-instance column="[Lost]" derivation='None' name="[none:Lost:ok]" pivot='key' type='ordinal' />
            <column-instance column="[NoResult]" derivation='None' name="[none:NoResult:ok]" pivot='key' type='ordinal' />
            <column-instance column="[NetRunRateLabel]" derivation='None' name="[none:NetRunRateLabel:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_FormIcons]" derivation='None' name="[none:Calc_FormIcons:nk]" pivot='key' type='nominal' />
            <column-instance column="[Points]" derivation='Sum' name="[sum:Points:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Position]" derivation='None' name="[none:Position:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Position]" derivation='Min' name="[min:Position:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.pointstable].[none:Season:nk]' filter-group='10'>
            <groupfilter function='member' level='[none:Season:nk]' member='"2025"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.pointstable].[none:Position:qk]' included-values='in-range'>
            <max>5</max>
          </filter>
          <computed-sort column='[federated.pointstable].[none:PositionLabel:nk]' direction='ASC' using='[federated.pointstable].[min:Position:qk]' />
          <slices>
            <column>[federated.pointstable].[none:Season:nk]</column>
            <column>[federated.pointstable].[none:Position:qk]</column>
