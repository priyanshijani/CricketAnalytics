                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.dqscoretrend].[avg:Calc_NotPassedPct:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>% not passed: </run>
