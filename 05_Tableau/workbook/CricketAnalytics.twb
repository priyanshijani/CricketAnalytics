  <worksheets>
    <worksheet name="KPI Matches">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Match" name='federated.match' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.match'>
            <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[MatchId]" derivation='CountD' name="[ctd:MatchId:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='CountD' name="[ctd:Season:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.match].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.match].[none:Calc_SeasonSel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
