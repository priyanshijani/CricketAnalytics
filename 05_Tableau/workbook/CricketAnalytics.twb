    <worksheet name="Win % by Team and Season">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Win % by team and season</run>
          </formatted-text>
        </title>
