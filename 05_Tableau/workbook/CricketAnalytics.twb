    <worksheet name="Top Run Scorers">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Top 10 run scorers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Season" name='federated.playerseason' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.playerseason'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column datatype='integer' name="[Runs]" role='measure' type='quantitative' />
            <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
            <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) * 100 / SUM([BallsFaced])" />
            </column>
            <column caption="Batting average" datatype='real' default-format="n#,##0.0" name="[Calc_BatAvg]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) / SUM([Dismissals])" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Runs]" derivation='Sum' name="[sum:Runs:qk]" pivot='key' type='quantitative' />
            <column-instance column="[PlayerRole]" derivation='Attribute' name="[attr:PlayerRole:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_StrikeRate]" derivation='User' name="[usr:Calc_StrikeRate:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_BatAvg]" derivation='User' name="[usr:Calc_BatAvg:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerseason].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerseason].[none:PlayerName:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression="[Calc_RankRuns]" function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:PlayerName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.playerseason].[none:PlayerName:nk]' direction='DESC' using='[federated.playerseason].[sum:Runs:qk]' />
          <slices>
            <column>[federated.playerseason].[none:Calc_SeasonSel:nk]</column>
            <column>[federated.playerseason].[none:PlayerName:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.playerseason].[sum:Runs:qk]' />
              <tooltip column='[federated.playerseason].[attr:PlayerRole:nk]' />
