            <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
            <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([RunsConceded]) * 6 / SUM([LegalBallsBowled])" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Wickets]" derivation='Sum' name="[sum:Wickets:qk]" pivot='key' type='quantitative' />
            <column-instance column="[PlayerRole]" derivation='Attribute' name="[attr:PlayerRole:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_Economy]" derivation='User' name="[usr:Calc_Economy:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
