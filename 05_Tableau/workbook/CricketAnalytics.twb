                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> (</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[attr:PlayerRole:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>)&#10;</run>
