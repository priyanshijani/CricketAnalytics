    <worksheet name="Player Home vs Away">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Home vs away: batting average</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Batting Innings" name='federated.battinginnings' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.playercareer].[PlayerName]' caption="Player" datatype='string' name="[Select Player]" param-domain-type='list' role='measure' type='nominal' value='"Naveen Bhatt"'>
          <calculation class='tableau' formula='"Naveen Bhatt"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.battinginnings'>
            <column caption="Home / away" datatype='string' name="[Calc_HomeAway]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [IsHome] THEN 'Home' ELSE 'Away' END" />
            </column>
            <column caption="Batting average" datatype='real' default-format="n#,##0.0" name="[Calc_BatAvg]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([RunsScored]) / SUM([Calc_Dismissed])" />
            </column>
            <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([RunsScored]) * 100 / SUM([BallsFaced])" />
            </column>
            <column caption="Runs" datatype='integer' name="[RunsScored]" role='measure' type='quantitative' />
            <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
            <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[Calc_HomeAway]" derivation='None' name="[none:Calc_HomeAway:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_BatAvg]" derivation='User' name="[usr:Calc_BatAvg:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_StrikeRate]" derivation='User' name="[usr:Calc_StrikeRate:qk]" pivot='key' type='quantitative' />
            <column-instance column="[RunsScored]" derivation='Sum' name="[sum:RunsScored:qk]" pivot='key' type='quantitative' />
            <column-instance column="[MatchId]" derivation='CountD' name="[ctd:MatchId:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelPlayer]" derivation='None' name="[none:Calc_SelPlayer:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.battinginnings].[none:Calc_SelPlayer:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelPlayer:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.battinginnings].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.battinginnings].[none:Calc_SelPlayer:nk]</column>
            <column>[federated.battinginnings].[none:Calc_SeasonSel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.battinginnings].[none:Calc_HomeAway:nk]' />
              <text column='[federated.battinginnings].[usr:Calc_BatAvg:qk]' />
              <tooltip column='[federated.battinginnings].[usr:Calc_StrikeRate:qk]' />
              <tooltip column='[federated.battinginnings].[sum:RunsScored:qk]' />
              <tooltip column='[federated.battinginnings].[ctd:MatchId:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.battinginnings].[none:Calc_HomeAway:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;Average </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.battinginnings].[usr:Calc_BatAvg:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>, strike rate </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.battinginnings].[usr:Calc_StrikeRate:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>, </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.battinginnings].[sum:RunsScored:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> runs in </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.battinginnings].[ctd:MatchId:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> innings</run>
              </formatted-text>
            </customized-tooltip>
