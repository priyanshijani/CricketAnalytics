            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.dqscoretrend].[avg:Calc_NotPassedPct:qk]' value="n#,##0.0" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.dqscoretrend].[none:EntityType:nk]' />
              <tooltip column='[federated.dqscoretrend].[attr:LoadRunId:nk]' />
              <tooltip column='[federated.dqscoretrend].[sum:RowsFailed:qk]' />
              <tooltip column='[federated.dqscoretrend].[sum:RowsChecked:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.dqscoretrend].[none:EntityType:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>, run </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.dqscoretrend].[attr:LoadRunId:nk]&gt;</run>
