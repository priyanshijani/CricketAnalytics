              <text column='[federated.match].[ctd:MatchId:qk]' />
              <text column='[federated.match].[ctd:Season:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='9'>Matches&#10;</run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='22'>&lt;[federated.match].[ctd:MatchId:qk]&gt;</run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'>&#10;across </run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'>&lt;[federated.match].[ctd:Season:qk]&gt;</run>
                <run fontcolor='#6B7785' fontname='Tableau Book' fontsize='8'> season(s)</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
