                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>Most wins: </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[none:TeamCurrentName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>, </run>
