    <datasource caption="Player Season" inline='true' name='federated.playerseason' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="PlayerSeason" name='hyper.playerseason'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_PlayerSeason.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.playerseason' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.playerseason' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name="[PlayerCode]" role='dimension' type='nominal' />
      <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
      <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column datatype='integer' name="[Matches]" role='measure' type='quantitative' />
      <column caption="Innings batted" datatype='integer' name="[InningsBatted]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Runs]" role='measure' type='quantitative' />
      <column caption="Balls" datatype='integer' name="[BallsFaced]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Dismissals]" role='measure' type='quantitative' />
      <column datatype='integer' name="[InningsBowled]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Wickets]" role='measure' type='quantitative' />
      <column caption="Runs conceded" datatype='integer' name="[RunsConceded]" role='measure' type='quantitative' />
      <column datatype='integer' name="[LegalBallsBowled]" role='measure' type='quantitative' />
      <column datatype='integer' name="[ImpactPoints]" role='measure' type='quantitative' />
      <column datatype='real' name="[BattingAverage]" role='measure' type='quantitative' />
      <column caption="Strike rate" datatype='real' name="[StrikeRate]" role='measure' type='quantitative' />
      <column datatype='real' name="[Economy]" role='measure' type='quantitative' />
      <column datatype='real' name="[BowlingAverage]" role='measure' type='quantitative' />
      <column caption="Overs" datatype='real' name="[OversBowled]" role='measure' type='quantitative' />
      <column caption="Impact per match" datatype='real' name="[ImpactPerMatch]" role='measure' type='quantitative' />
      <column caption="Runs vs previous season" datatype='integer' name="[RunsChangeVsPriorSeason]" role='measure' type='quantitative' />
      <column datatype='integer' name="[WicketsChangeVsPriorSeason]" role='measure' type='quantitative' />
      <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
      </column>
      <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
      </column>
      <column caption="Size of change in runs" datatype='integer' name="[Calc_AbsRunsChange]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="ABS([RunsChangeVsPriorSeason])" />
      </column>
      <column caption="Direction" datatype='string' name="[Calc_ChangeDirection]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [RunsChangeVsPriorSeason] &gt;= 0 THEN 'Improving' ELSE 'Declining' END" />
      </column>
      <column caption="Batting average" datatype='real' default-format="n#,##0.0" name="[Calc_BatAvg]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Runs]) / SUM([Dismissals])" />
      </column>
      <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Runs]) * 100 / SUM([BallsFaced])" />
      </column>
      <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([RunsConceded]) * 6 / SUM([LegalBallsBowled])" />
      </column>
      <column caption="Runs (ranking)" datatype='real' name="[Calc_RankRuns]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Runs])" />
      </column>
      <column caption="Wickets (ranking)" datatype='real' name="[Calc_RankWickets]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Wickets])" />
      </column>
      <column caption="League batting average" datatype='real' default-format="n#,##0.0" name="[Calc_LeagueAvg]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED : SUM([Runs])} / {FIXED : SUM([Dismissals])}" />
      </column>
      <column caption="League strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_LeagueSR]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED : SUM([Runs])} * 100 / {FIXED : SUM([BallsFaced])}" />
      </column>
      <column caption="League economy" datatype='real' default-format="n#,##0.00" name="[Calc_LeagueEcon]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED : SUM([RunsConceded])} * 6 / {FIXED : SUM([LegalBallsBowled])}" />
      </column>
      <column caption="Batting verdict" datatype='string' name="[Calc_BatVerdict]" role='measure' type='nominal'>
        <calculation class='tableau' formula="IF [Calc_StrikeRate] &gt;= MIN([Calc_LeagueSR]) AND [Calc_BatAvg] &gt;= MIN([Calc_LeagueAvg]) THEN 'Above the league on both pace and output.' ELSEIF [Calc_StrikeRate] &gt;= MIN([Calc_LeagueSR]) THEN 'Scores faster than the league but gets out sooner.' ELSEIF [Calc_BatAvg] &gt;= MIN([Calc_LeagueAvg]) THEN 'Reliable, but scores slower than the league.' ELSE 'Below the league average as a batter.' END" />
      </column>
      <column-instance column='[Calc_ChangeDirection]' derivation='None' name='[none:Calc_ChangeDirection:nk]' pivot='key' type='nominal' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calc_ChangeDirection:nk]' type='palette'>
            <map to='#5E8C3A'>
              <bucket>&quot;Improving&quot;</bucket>
            </map>
            <map to='#D1495B'>
              <bucket>&quot;Declining&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption="PlayerSeason" id='PlayerSeason_0A7E1D09B6375D048E2EAD8A03E1BAC6'>
            <properties context=''>
              <relation connection='hyper.playerseason' name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption="Player Phase" inline='true' name='federated.playerphase' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="PlayerPhase" name='hyper.playerphase'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_PlayerPhase.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
