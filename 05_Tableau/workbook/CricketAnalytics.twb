    <datasource caption="Over Progression" inline='true' name='federated.overprogression' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="OverProgression" name='hyper.overprogression'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_OverProgression.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.overprogression' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.overprogression' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column datatype='integer' name="[InningsNo]" role='dimension' type='ordinal' />
      <column caption="Team" datatype='string' name="[BattingTeamCode]" role='dimension' type='nominal' />
      <column caption="Batting team" datatype='string' name="[BattingTeamName]" role='dimension' type='nominal' />
      <column caption="Over" datatype='integer' name="[OverNo]" role='dimension' type='ordinal' />
      <column datatype='string' name="[Phase]" role='dimension' type='nominal' />
      <column caption="Runs in the over" datatype='integer' name="[RunsInOver]" role='measure' type='quantitative' />
      <column caption="Wickets in the over" datatype='integer' name="[WicketsInOver]" role='measure' type='quantitative' />
      <column caption="Cumulative runs" datatype='integer' name="[CumulativeRuns]" role='measure' type='quantitative' />
      <column datatype='integer' name="[CumulativeWickets]" role='measure' type='quantitative' />
      <column caption="Selected match" datatype='boolean' name="[Calc_SelMatch]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[MatchId] = SPLIT([Parameters].[Select Match], ' | ', 1)" />
      </column>
      <column caption="Phase" datatype='string' name="[Calc_Phase]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="CASE [Phase] WHEN 'Powerplay' THEN '1 Powerplay (overs 1-6)' WHEN 'Middle' THEN '2 Middle (7-15)' ELSE '3 Death (16-20)' END" />
      </column>
      <column caption="Over" datatype='string' name="[Calc_OverLabel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[BattingTeamCode] + ' over ' + STR([OverNo])" />
      </column>
      <column caption="Biggest over (ranking)" datatype='real' name="[Calc_RankBigOver]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([RunsInOver]) * 10000 - MIN([InningsNo]) * 100 - MIN([OverNo])" />
      </column>
      <column caption="Most damaging over (ranking)" datatype='real' name="[Calc_RankWicketOver]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([WicketsInOver]) * 1000000 - SUM([RunsInOver]) * 1000 - MIN([InningsNo]) * 100 - MIN([OverNo])" />
      </column>
      <column-instance column='[BattingTeamName]' derivation='None' name='[none:BattingTeamName:nk]' pivot='key' type='nominal' />
      <style>
        <style-rule element='mark'>
