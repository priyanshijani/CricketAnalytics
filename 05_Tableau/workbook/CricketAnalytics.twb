    </worksheet>
    <worksheet name="Venue Profile">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Venue profile: average first-innings score (label: how often the chasing side won)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Team Match" name='federated.teammatch' />
          </datasources>
          <datasource-dependencies datasource='federated.teammatch'>
            <column caption="Venue" datatype='string' name="[VenueName]" role='dimension' type='nominal' />
            <column caption="Average first-innings score" datatype='real' default-format="n#,##0" name="[Calc_FirstInningsScore]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="AVG(IF [BattedFirst] = 1 THEN [RunsScored] END)" />
            </column>
            <column caption="Won chasing" datatype='real' default-format="p0%" name="[Calc_ChaseWin]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsWin] END) / SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
            </column>
            <column caption="Matches chasing" datatype='real' default-format="n#,##0" name="[Calc_ChaseN]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
            </column>
            <column-instance column="[VenueName]" derivation='None' name="[none:VenueName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_FirstInningsScore]" derivation='User' name="[usr:Calc_FirstInningsScore:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChaseWin]" derivation='User' name="[usr:Calc_ChaseWin:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChaseN]" derivation='User' name="[usr:Calc_ChaseN:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.teammatch].[none:VenueName:nk]' direction='DESC' using='[federated.teammatch].[usr:Calc_FirstInningsScore:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.teammatch].[usr:Calc_FirstInningsScore:qk]' field-type='quantitative' max='260' min='0' range-type='fixed' scope='cols' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.teammatch].[usr:Calc_FirstInningsScore:qk]' />
              <text column='[federated.teammatch].[usr:Calc_ChaseWin:qk]' />
              <text column='[federated.teammatch].[usr:Calc_ChaseN:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[none:VenueName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;Average first-innings score </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.teammatch].[usr:Calc_FirstInningsScore:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>; the chasing side won </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.teammatch].[usr:Calc_ChaseWin:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> of </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.teammatch].[usr:Calc_ChaseN:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> decided chases</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run>&lt;[federated.teammatch].[usr:Calc_FirstInningsScore:qk]&gt;</run>
                <run>  ·  chasers won </run>
                <run>&lt;[federated.teammatch].[usr:Calc_ChaseWin:qk]&gt;</run>
                <run> of </run>
                <run>&lt;[federated.teammatch].[usr:Calc_ChaseN:qk]&gt;</run>
                <run> chases</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.teammatch].[none:VenueName:nk]</rows>
        <cols>[federated.teammatch].[usr:Calc_FirstInningsScore:qk]</cols>
      </table>
      <simple-id uuid='{E8F9216B-CD4D-530D-B4C0-DDE313342F1D}' />
    </worksheet>
