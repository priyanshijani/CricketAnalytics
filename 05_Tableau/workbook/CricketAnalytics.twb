            </map>
            <map to='#E07A2F'>
              <bucket>&quot;Delhi Falcons&quot;</bucket>
            </map>
            <map to='#9AA5B1'>
              <bucket>&quot;Hyderabad Hawks&quot;</bucket>
            </map>
            <map to='#2E86AB'>
              <bucket>&quot;Kolkata Tigers&quot;</bucket>
            </map>
            <map to='#C9A227'>
              <bucket>&quot;Mumbai Sharks&quot;</bucket>
            </map>
            <map to='#5C6F82'>
              <bucket>&quot;Punjab Warriors&quot;</bucket>
            </map>
            <map to='#B5838D'>
              <bucket>&quot;Rajasthan Titans&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
