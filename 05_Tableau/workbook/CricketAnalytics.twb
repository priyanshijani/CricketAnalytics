        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.playerphase' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name="[PlayerCode]" role='dimension' type='nominal' />
      <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
      <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column datatype='string' name="[Phase]" role='dimension' type='nominal' />
      <column datatype='string' name="[Discipline]" role='dimension' type='nominal' />
      <column datatype='integer' name="[Runs]" role='measure' type='quantitative' />
      <column caption="Balls" datatype='integer' name="[Balls]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Wickets]" role='measure' type='quantitative' />
      <column caption="Strike rate" datatype='real' name="[StrikeRate]" role='measure' type='quantitative' />
      <column datatype='real' name="[Economy]" role='measure' type='quantitative' />
      <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
      </column>
      <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
      </column>
      <column caption="Phase" datatype='string' name="[Calc_Phase]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="CASE [Phase] WHEN 'Powerplay' THEN '1 Powerplay (overs 1-6)' WHEN 'Middle' THEN '2 Middle (7-15)' ELSE '3 Death (16-20)' END" />
      </column>
      <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Runs]) * 100 / SUM([Balls])" />
      </column>
      <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Runs]) * 6 / SUM([Balls])" />
      </column>
      <column caption="League strike rate in the phase" datatype='real' default-format="n#,##0.0" name="[Calc_LeaguePhaseSR]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED [Phase], [Discipline] : SUM([Runs])} * 100 / {FIXED [Phase], [Discipline] : SUM([Balls])}" />
      </column>
      <column caption="League economy in the phase" datatype='real' default-format="n#,##0.00" name="[Calc_LeaguePhaseEcon]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED [Phase], [Discipline] : SUM([Runs])} * 6 / {FIXED [Phase], [Discipline] : SUM([Balls])}" />
      </column>
      <column caption="Death strike rate (min 30 balls)" datatype='real' name="[Calc_RankDeathSR]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF SUM([Balls]) &gt;= 30 THEN SUM([Runs]) * 100 / SUM([Balls]) ELSE -1 END" />
      </column>
      <column caption="Death-over runs conceded" datatype='integer' name="[Calc_DeathRuns]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [Phase] = 'Death' THEN [Runs] END" />
      </column>
      <column caption="Death-over balls" datatype='integer' name="[Calc_DeathBalls]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [Phase] = 'Death' THEN [Balls] END" />
      </column>
      <column caption="Death economy (min 60 balls)" datatype='real' name="[Calc_RankDeathEcon]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF SUM([Calc_DeathBalls]) &gt;= 60 THEN SUM([Calc_DeathRuns]) * 6 / SUM([Calc_DeathBalls]) ELSE 99 END" />
      </column>
      <column-instance column='[Calc_Phase]' derivation='None' name='[none:Calc_Phase:nk]' pivot='key' type='nominal' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calc_Phase:nk]' type='palette'>
            <map to='#4A90A4'>
              <bucket>&quot;1 Powerplay (overs 1-6)&quot;</bucket>
            </map>
            <map to='#9AA5B1'>
              <bucket>&quot;2 Middle (7-15)&quot;</bucket>
            </map>
            <map to='#D1495B'>
              <bucket>&quot;3 Death (16-20)&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption="PlayerPhase" id='PlayerPhase_F183365BA13C55CBBE736C2B37A4B3A4'>
            <properties context=''>
              <relation connection='hyper.playerphase' name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
