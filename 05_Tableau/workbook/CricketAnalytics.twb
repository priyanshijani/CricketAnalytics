          </filter>
          <filter class='categorical' column='[federated.dqrowoutcome].[none:Outcome:nk]'>
            <groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression="[Calc_RankReason]" function='order' user:ui-marker='order'>
