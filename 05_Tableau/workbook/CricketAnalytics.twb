    <worksheet name="Load Status">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Last finished run of each workflow: rows out</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Load Status" name='federated.loadstatus' />
          </datasources>
          <datasource-dependencies datasource='federated.loadstatus'>
            <column caption="Workflow" datatype='string' name="[WorkflowName]" role='dimension' type='nominal' />
            <column datatype='string' name="[Status]" role='dimension' type='nominal' />
            <column caption="Finished" datatype='datetime' name="[EndTime]" role='dimension' type='ordinal' />
            <column caption="Rows out" datatype='integer' name="[RowsOut]" role='measure' type='quantitative' />
            <column-instance column="[WorkflowName]" derivation='None' name="[none:WorkflowName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Status]" derivation='None' name="[none:Status:nk]" pivot='key' type='nominal' />
            <column-instance column="[EndTime]" derivation='None' name="[none:EndTime:ok]" pivot='key' type='ordinal' />
            <column-instance column="[RowsOut]" derivation='Sum' name="[sum:RowsOut:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.loadstatus].[sum:RowsOut:qk]' />
