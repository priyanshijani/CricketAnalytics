                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> of </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.dqscoretrend].[sum:RowsChecked:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> rows</run>
