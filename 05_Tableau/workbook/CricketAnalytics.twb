            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[none:Season:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;• </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[sum:Wickets:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> wickets at an economy of </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[usr:Calc_Economy:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> from </run>
