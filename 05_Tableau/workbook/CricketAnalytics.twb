    <worksheet name="Bat First or Chase">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Batting first vs chasing (line = 50%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Team Match" name='federated.teammatch' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.teammatch].[TeamCurrentName]' caption="Team" datatype='string' name="[Select Team]" param-domain-type='list' role='measure' type='nominal' value='"Bangalore Royals"'>
          <calculation class='tableau' formula='"Bangalore Royals"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.teammatch'>
            <column caption="Batted first?" datatype='string' name="[Calc_BattedFirstLabel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [BattedFirst] = 1 THEN 'Batted first' ELSEIF [BattedFirst] = 0 THEN 'Chased' ELSE 'No play' END" />
            </column>
            <column caption="Win %" datatype='real' default-format="p0%" name="[Calc_WinPct]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([IsWin]) / SUM([IsDecided])" />
            </column>
            <column caption="Sample size" datatype='string' name="[Calc_Sample]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF SUM([IsDecided]) &gt;= 3 THEN '3+ matches' ELSE 'Under 3 matches (small sample)' END" />
            </column>
            <column caption="Wins" datatype='integer' name="[IsWin]" role='measure' type='quantitative' />
            <column caption="Matches" datatype='integer' name="[IsDecided]" role='measure' type='quantitative' />
            <column caption="Coin flip (50%)" datatype='real' default-format="p0%" name="[Calc_Half]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="0.5" />
            </column>
            <column caption="Selected team" datatype='boolean' name="[Calc_SelTeam]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[TeamCurrentName] = [Parameters].[Select Team]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[Calc_BattedFirstLabel]" derivation='None' name="[none:Calc_BattedFirstLabel:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_WinPct]" derivation='User' name="[usr:Calc_WinPct:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_Sample]" derivation='User' name="[usr:Calc_Sample:nk]" pivot='key' type='nominal' />
            <column-instance column="[IsWin]" derivation='Sum' name="[sum:IsWin:qk]" pivot='key' type='quantitative' />
            <column-instance column="[IsDecided]" derivation='Sum' name="[sum:IsDecided:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_Half]" derivation='Max' name="[max:Calc_Half:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelTeam]" derivation='None' name="[none:Calc_SelTeam:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.teammatch].[none:Calc_SelTeam:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelTeam:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.teammatch].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.teammatch].[none:Calc_BattedFirstLabel:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:Calc_BattedFirstLabel:nk]' member='"Batted first"' /><groupfilter function='member' level='[none:Calc_BattedFirstLabel:nk]' member='"Chased"' /></groupfilter>
          </filter>
          <slices>
            <column>[federated.teammatch].[none:Calc_SelTeam:nk]</column>
            <column>[federated.teammatch].[none:Calc_SeasonSel:nk]</column>
            <column>[federated.teammatch].[none:Calc_BattedFirstLabel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.teammatch].[usr:Calc_WinPct:qk]' field-type='quantitative' max='1.7' min='0' range-type='fixed' scope='cols' type='space' />
          </style-rule>
          <style-rule element='refline'>
            <format attr='stroke-color' id='refline0' value='#6B7785' />
            <format attr='color' id='refline0' value='#6B7785' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.teammatch].[usr:Calc_Sample:nk]' />
              <text column='[federated.teammatch].[usr:Calc_WinPct:qk]' />
              <text column='[federated.teammatch].[sum:IsWin:qk]' />
              <text column='[federated.teammatch].[sum:IsDecided:qk]' />
              <lod column='[federated.teammatch].[max:Calc_Half:qk]' />
            </encodings>
            <reference-line axis-column='[federated.teammatch].[usr:Calc_WinPct:qk]' enable-instant-analytics='false' formula='average' id='refline0' label-type='none' scope='per-table' value-column='[federated.teammatch].[max:Calc_Half:qk]' z-order='1' />
            <customized-label>
              <formatted-text>
                <run>&lt;[federated.teammatch].[usr:Calc_WinPct:qk]&gt;</run>
                <run>  ·  </run>
                <run>&lt;[federated.teammatch].[sum:IsWin:qk]&gt;</run>
                <run> of </run>
                <run>&lt;[federated.teammatch].[sum:IsDecided:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.teammatch].[none:Calc_BattedFirstLabel:nk]</rows>
        <cols>[federated.teammatch].[usr:Calc_WinPct:qk]</cols>
