    <worksheet name="DQ Score Trend">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>% of rows not passed, per DQ run (lower is better)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="DQ Score Trend" name='federated.dqscoretrend' />
          </datasources>
          <datasource-dependencies datasource='federated.dqscoretrend'>
            <column caption="% of rows not passed" datatype='real' default-format="n#,##0.0" name="[Calc_NotPassedPct]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="100 - [ScorePct]" />
            </column>
            <column caption="DQ run time" datatype='datetime' name="[ScoredAtUtc]" role='dimension' type='ordinal' />
            <column caption="Entity" datatype='string' name="[EntityType]" role='dimension' type='nominal' />
            <column caption="DQ run" datatype='string' name="[LoadRunId]" role='dimension' type='nominal' />
            <column caption="Rows not passed" datatype='integer' name="[RowsFailed]" role='measure' type='quantitative' />
            <column caption="Rows checked" datatype='integer' name="[RowsChecked]" role='measure' type='quantitative' />
            <column caption="Quality dimension" datatype='string' name="[Dimension]" role='dimension' type='nominal' />
            <column-instance column="[Calc_NotPassedPct]" derivation='Avg' name="[avg:Calc_NotPassedPct:qk]" pivot='key' type='quantitative' />
            <column-instance column="[ScoredAtUtc]" derivation='None' name="[none:ScoredAtUtc:qk]" pivot='key' type='quantitative' />
            <column-instance column="[EntityType]" derivation='None' name="[none:EntityType:nk]" pivot='key' type='nominal' />
            <column-instance column="[LoadRunId]" derivation='Attribute' name="[attr:LoadRunId:nk]" pivot='key' type='nominal' />
            <column-instance column="[RowsFailed]" derivation='Sum' name="[sum:RowsFailed:qk]" pivot='key' type='quantitative' />
            <column-instance column="[RowsChecked]" derivation='Sum' name="[sum:RowsChecked:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Dimension]" derivation='None' name="[none:Dimension:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.dqscoretrend].[none:Dimension:nk]'>
            <groupfilter function='member' level='[none:Dimension:nk]' member='"Overall"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.dqscoretrend].[none:Dimension:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
