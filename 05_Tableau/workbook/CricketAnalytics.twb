  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column _.fcp.ParameterDefaultValues.true...source-field='[federated.match].[MatchLabel]' caption="Match" datatype='string' name="[Select Match]" param-domain-type='list' role='measure' type='nominal' value='"M0120 | 2025-06-18 | MUM v DEL"'>
        <calculation class='tableau' formula='"M0120 | 2025-06-18 | MUM v DEL"' />
      </column>
      <column _.fcp.ParameterDefaultValues.true...source-field='[federated.teammatch].[TeamCurrentName]' caption="Team" datatype='string' name="[Select Team]" param-domain-type='list' role='measure' type='nominal' value='"Bangalore Royals"'>
        <calculation class='tableau' formula='"Bangalore Royals"' />
      </column>
      <column _.fcp.ParameterDefaultValues.true...source-field='[federated.playercareer].[PlayerName]' caption="Player" datatype='string' name="[Select Player]" param-domain-type='list' role='measure' type='nominal' value='"Naveen Bhatt"'>
        <calculation class='tableau' formula='"Naveen Bhatt"' />
      </column>
      <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
        <calculation class='tableau' formula='"All seasons"' />
      </column>
    </datasource>
    <datasource caption="Match" inline='true' name='federated.match' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="Match" name='hyper.match'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_Match.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.match' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.match' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
      <column datatype='date' name="[MatchDate]" role='dimension' type='ordinal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column datatype='string' name="[FormatCode]" role='dimension' type='nominal' />
      <column datatype='string' name="[FormatName]" role='dimension' type='nominal' />
      <column datatype='string' name="[MatchLabel]" role='dimension' type='nominal' />
      <column datatype='string' name="[VenueCode]" role='dimension' type='nominal' />
      <column caption="Venue" datatype='string' name="[VenueName]" role='dimension' type='nominal' />
      <column datatype='string' name="[City]" role='dimension' type='nominal' />
      <column datatype='string' name="[Team1Code]" role='dimension' type='nominal' />
      <column datatype='string' name="[Team1Name]" role='dimension' type='nominal' />
      <column datatype='string' name="[Team2Code]" role='dimension' type='nominal' />
      <column datatype='string' name="[Team2Name]" role='dimension' type='nominal' />
      <column datatype='string' name="[TossWinnerCode]" role='dimension' type='nominal' />
      <column datatype='string' name="[TossWinnerName]" role='dimension' type='nominal' />
      <column caption="Toss decision" datatype='string' name="[TossDecision]" role='dimension' type='nominal' />
      <column datatype='string' name="[WinnerCode]" role='dimension' type='nominal' />
      <column datatype='string' name="[WinnerName]" role='dimension' type='nominal' />
      <column datatype='string' name="[ResultMethod]" role='dimension' type='nominal' />
      <column caption="Winning margin" datatype='integer' name="[WinMargin]" role='measure' type='quantitative' />
      <column caption="Won by" datatype='string' name="[WinMarginType]" role='dimension' type='nominal' />
      <column datatype='string' name="[ManOfMatch]" role='dimension' type='nominal' />
      <column datatype='integer' name="[Team1Runs]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Team1Wickets]" role='measure' type='quantitative' />
      <column datatype='real' name="[Team1Overs]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Team2Runs]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Team2Wickets]" role='measure' type='quantitative' />
      <column datatype='real' name="[Team2Overs]" role='measure' type='quantitative' />
      <column datatype='string' name="[BattingFirstCode]" role='dimension' type='nominal' />
      <column caption="Toss winner won" datatype='integer' default-format="p0%" name="[TossWinnerWonMatch]" role='measure' type='quantitative' />
      <column caption="Team batting first won" datatype='integer' default-format="p0%" name="[BattingFirstWon]" role='measure' type='quantitative' />
      <column datatype='string' name="[InningsStatus]" role='dimension' type='nominal' />
      <column datatype='string' name="[BallByBallStatus]" role='dimension' type='nominal' />
      <column datatype='integer' name="[IsComplete]" role='measure' type='quantitative' />
      <column caption="Selected match" datatype='boolean' name="[Calc_SelMatch]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[MatchId] = SPLIT([Parameters].[Select Match], ' | ', 1)" />
      </column>
      <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
      </column>
      <column caption="Result type" datatype='string' name="[Calc_ResultType]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [ResultMethod] = 'Normal' THEN 'Won by ' + LOWER([WinMarginType]) ELSE [ResultMethod] END" />
      </column>
      <column caption="Result" datatype='string' name="[Calc_ResultText]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [ResultMethod] = 'Normal' THEN [WinnerName] + ' won by ' + STR([WinMargin]) + ' ' + LOWER([WinMarginType]) ELSEIF [ResultMethod] = 'SuperOver' THEN [WinnerName] + ' won the super over' ELSE [ResultMethod] END" />
      </column>
      <column caption="Scores" datatype='string' name="[Calc_Scores]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[Team1Code] + ' ' + STR([Team1Runs]) + '/' + STR([Team1Wickets]) + '  v  ' + [Team2Code] + ' ' + STR([Team2Runs]) + '/' + STR([Team2Wickets])" />
      </column>
      <column caption="Coin flip (50%)" datatype='real' default-format="p0%" name="[Calc_Half]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="0.5" />
      </column>
      <column caption="Chance range (± points, 95%)" datatype='real' default-format="n#,##0" name="[Calc_ChanceRange]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="100 * 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch]))" />
      </column>
      <column caption="Verdict" datatype='string' name="[Calc_TossVerdict]" role='measure' type='nominal'>
        <calculation class='tableau' formula="IF ABS(AVG([TossWinnerWonMatch]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch])) AND ABS(AVG([BattingFirstWon]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([BattingFirstWon])) THEN 'both are real edges at this sample size' ELSEIF ABS(AVG([TossWinnerWonMatch]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([TossWinnerWonMatch])) THEN 'winning the toss is a real edge; batting first is not' ELSEIF ABS(AVG([BattingFirstWon]) - 0.5) &gt; 1.96 * SQRT(0.25 / COUNT([BattingFirstWon])) THEN 'batting first is a real edge; the toss is not' ELSE 'neither is a reliable edge yet - both are within what chance alone gives' END" />
      </column>
      <column caption="Share of the season's matches" datatype='real' default-format="p0%" name="[Calc_SeasonShare]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="COUNTD([MatchId]) / MIN({FIXED [Season] : COUNTD([MatchId])})" />
      </column>
      <column caption="Close finish" datatype='integer' name="[Calc_CloseFinish]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [ResultMethod] = 'Tied' OR [ResultMethod] = 'SuperOver' THEN 1 ELSEIF [ResultMethod] = 'Normal' THEN (IF ([WinMarginType] = 'Runs' AND [WinMargin] &lt;= 10) OR ([WinMarginType] = 'Wickets' AND [WinMargin] &lt;= 2) THEN 1 ELSE 0 END) END" />
      </column>
      <column caption="Close finishes" datatype='real' default-format="p0%" name="[Calc_ClosePct]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="AVG([Calc_CloseFinish])" />
      </column>
      <column caption="Close finishes, all seasons" datatype='real' default-format="p0%" name="[Calc_ClosePctAll]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED : AVG([Calc_CloseFinish])}" />
      </column>
      <column-instance column='[Calc_ResultType]' derivation='None' name='[none:Calc_ResultType:nk]' pivot='key' type='nominal' />
      <column-instance column='[TossDecision]' derivation='None' name='[none:TossDecision:nk]' pivot='key' type='nominal' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calc_ResultType:nk]' type='palette'>
            <map to='#1F4E79'>
              <bucket>&quot;Won by runs&quot;</bucket>
            </map>
            <map to='#4A90A4'>
              <bucket>&quot;Won by wickets&quot;</bucket>
            </map>
            <map to='#F2A900'>
              <bucket>&quot;Tied&quot;</bucket>
            </map>
            <map to='#E07A2F'>
              <bucket>&quot;SuperOver&quot;</bucket>
            </map>
            <map to='#C3CBD4'>
              <bucket>&quot;NoResult&quot;</bucket>
            </map>
            <map to='#5C6F82'>
              <bucket>&quot;Abandoned&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:TossDecision:nk]' type='palette'>
            <map to='#1F4E79'>
              <bucket>&quot;Bat&quot;</bucket>
            </map>
            <map to='#F2A900'>
              <bucket>&quot;Field&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption="Match" id='Match_D7992CFC2E8458B8A14D4E752EB93B04'>
            <properties context=''>
              <relation connection='hyper.match' name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption="Team Match" inline='true' name='federated.teammatch' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="TeamMatch" name='hyper.teammatch'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_TeamMatch.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.teammatch' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.teammatch' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption="Matches" datatype='string' name="[MatchId]" role='dimension' type='nominal' />
      <column datatype='date' name="[MatchDate]" role='dimension' type='ordinal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column datatype='string' name="[FormatCode]" role='dimension' type='nominal' />
      <column datatype='string' name="[VenueCode]" role='dimension' type='nominal' />
      <column caption="Venue" datatype='string' name="[VenueName]" role='dimension' type='nominal' />
      <column datatype='string' name="[City]" role='dimension' type='nominal' />
      <column datatype='string' name="[TeamCode]" role='dimension' type='nominal' />
      <column caption="Team" datatype='string' name="[TeamName]" role='dimension' type='nominal' />
      <column caption="Team" datatype='string' name="[TeamCurrentName]" role='dimension' type='nominal' />
      <column datatype='string' name="[OpponentCode]" role='dimension' type='nominal' />
      <column datatype='string' name="[OpponentName]" role='dimension' type='nominal' />
      <column caption="Opponent" datatype='string' name="[OpponentCurrentName]" role='dimension' type='nominal' />
      <column datatype='string' name="[Result]" role='dimension' type='nominal' />
      <column caption="Wins" datatype='integer' name="[IsWin]" role='measure' type='quantitative' />
      <column caption="Matches" datatype='integer' name="[IsDecided]" role='measure' type='quantitative' />
      <column datatype='string' name="[ResultMethod]" role='dimension' type='nominal' />
      <column caption="Winning margin" datatype='integer' name="[WinMargin]" role='measure' type='quantitative' />
      <column caption="Won by" datatype='string' name="[WinMarginType]" role='dimension' type='nominal' />
      <column caption="Runs" datatype='integer' name="[RunsScored]" role='measure' type='quantitative' />
      <column caption="Wickets" datatype='integer' name="[WicketsLost]" role='measure' type='quantitative' />
      <column datatype='real' name="[OversPlayed]" role='measure' type='quantitative' />
      <column caption="Runs conceded" datatype='integer' name="[RunsConceded]" role='measure' type='quantitative' />
      <column datatype='integer' name="[WicketsTaken]" role='measure' type='quantitative' />
      <column datatype='integer' name="[WonToss]" role='measure' type='quantitative' />
      <column datatype='integer' name="[BattedFirst]" role='measure' type='quantitative' />
      <column datatype='boolean' name="[IsHome]" role='dimension' type='nominal' />
      <column caption="Match number in season" datatype='integer' name="[SeasonMatchNo]" role='dimension' type='ordinal' />
      <column caption="Win % so far this season" datatype='real' default-format="p0%" name="[RunningWinPct]" role='measure' type='quantitative' />
      <column datatype='integer' name="[IsComplete]" role='measure' type='quantitative' />
      <column caption="Win %" datatype='real' default-format="p0%" name="[Calc_WinPct]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([IsWin]) / SUM([IsDecided])" />
      </column>
      <column caption="Selected team" datatype='boolean' name="[Calc_SelTeam]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[TeamCurrentName] = [Parameters].[Select Team]" />
      </column>
      <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
      </column>
      <column caption="Home / away" datatype='string' name="[Calc_HomeAway]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [IsHome] THEN 'Home' ELSE 'Away' END" />
      </column>
      <column caption="Batted first?" datatype='string' name="[Calc_BattedFirstLabel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="IF [BattedFirst] = 1 THEN 'Batted first' ELSEIF [BattedFirst] = 0 THEN 'Chased' ELSE 'No play' END" />
      </column>
      <column caption="Coin flip (50%)" datatype='real' default-format="p0%" name="[Calc_Half]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="0.5" />
      </column>
      <column caption="League average score" datatype='real' default-format="n#,##0" name="[Calc_LeagueScore]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="{FIXED : AVG([RunsScored])}" />
      </column>
      <column caption="Sample size" datatype='string' name="[Calc_Sample]" role='measure' type='nominal'>
        <calculation class='tableau' formula="IF SUM([IsDecided]) &gt;= 3 THEN '3+ matches' ELSE 'Under 3 matches (small sample)' END" />
      </column>
      <column caption="Won batting first" datatype='real' default-format="p0%" name="[Calc_BatFirstWin]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IF [BattedFirst] = 1 THEN [IsWin] END) / SUM(IF [BattedFirst] = 1 THEN [IsDecided] END)" />
      </column>
      <column caption="Won chasing" datatype='real' default-format="p0%" name="[Calc_ChaseWin]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsWin] END) / SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
      </column>
      <column caption="Matches batting first" datatype='real' default-format="n#,##0" name="[Calc_BatFirstN]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IF [BattedFirst] = 1 THEN [IsDecided] END)" />
      </column>
      <column caption="Matches chasing" datatype='real' default-format="n#,##0" name="[Calc_ChaseN]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
      </column>
      <column caption="Average first-innings score" datatype='real' default-format="n#,##0" name="[Calc_FirstInningsScore]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="AVG(IF [BattedFirst] = 1 THEN [RunsScored] END)" />
      </column>
      <column caption="Toss call" datatype='string' name="[Calc_TossCall]" role='measure' type='nominal'>
        <calculation class='tableau' formula="IF [Calc_BatFirstWin] &gt; [Calc_ChaseWin] THEN 'bat first' ELSEIF [Calc_ChaseWin] &gt; [Calc_BatFirstWin] THEN 'field and chase' ELSE 'either' END" />
      </column>
      <column caption="Strength of the evidence" datatype='string' name="[Calc_CallSignal]" role='measure' type='nominal'>
        <calculation class='tableau' formula="IF ABS([Calc_BatFirstWin] - [Calc_ChaseWin]) &gt; 1.96 * SQRT([Calc_WinPct] * (1 - [Calc_WinPct]) * (1 / [Calc_BatFirstN] + 1 / [Calc_ChaseN])) THEN 'the gap is bigger than chance - a clear edge' ELSE 'the gap is within what chance gives at this sample size - a lean, not a rule' END" />
      </column>
      <column caption="Wins (ranking)" datatype='real' name="[Calc_RankWins]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([IsWin]) * 1000 + SUM([IsWin]) / SUM([IsDecided])" />
      </column>
      <column-instance column='[Season]' derivation='None' name='[none:Season:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calc_Sample]' derivation='User' name='[usr:Calc_Sample:nk]' pivot='key' type='nominal' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Season:nk]' type='palette'>
            <map to='#1F4E79'>
              <bucket>&quot;2023&quot;</bucket>
            </map>
            <map to='#F2A900'>
              <bucket>&quot;2024&quot;</bucket>
            </map>
            <map to='#4A90A4'>
              <bucket>&quot;2025&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[usr:Calc_Sample:nk]' type='palette'>
            <map to='#1F4E79'>
              <bucket>&quot;3+ matches&quot;</bucket>
            </map>
            <map to='#C3CBD4'>
              <bucket>&quot;Under 3 matches (small sample)&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption="TeamMatch" id='TeamMatch_E2EF78E4BF2151F29BC2DF2E96DC0828'>
            <properties context=''>
              <relation connection='hyper.teammatch' name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption="Team Season" inline='true' name='federated.teamseason' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="TeamSeason" name='hyper.teamseason'>
            <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname="../../04_Prepared/rpt_TeamSeason.hyper" default-settings='yes' server='' sslmode='' username='tableau_internal_user' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='hyper.teamseason' name='Extract' table='[Extract].[Extract]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='hyper.teamseason' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name="[TeamCode]" role='dimension' type='nominal' />
      <column caption="Team" datatype='string' name="[TeamCurrentName]" role='dimension' type='nominal' />
      <column datatype='string' name="[Season]" role='dimension' type='nominal' />
      <column caption="P" datatype='integer' name="[Played]" role='measure' type='quantitative' />
      <column caption="W" datatype='integer' name="[Won]" role='measure' type='quantitative' />
      <column caption="L" datatype='integer' name="[Lost]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Tied]" role='measure' type='quantitative' />
      <column caption="NR" datatype='integer' name="[NoResult]" role='measure' type='quantitative' />
      <column caption="Win %" datatype='real' default-format="n#,##0.0" name="[WinPct]" role='measure' type='quantitative' />
      <column caption="Runs" datatype='integer' name="[RunsScored]" role='measure' type='quantitative' />
      <column caption="Runs conceded" datatype='integer' name="[RunsConceded]" role='measure' type='quantitative' />
      <column datatype='integer' name="[HomeMatches]" role='measure' type='quantitative' />
