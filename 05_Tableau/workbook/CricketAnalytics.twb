    <worksheet name="Insight Team">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Team Match" name='federated.teammatch' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.teammatch].[TeamCurrentName]' caption="Team" datatype='string' name="[Select Team]" param-domain-type='list' role='measure' type='nominal' value='"Bangalore Royals"'>
          <calculation class='tableau' formula='"Bangalore Royals"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.teammatch'>
            <column caption="Team" datatype='string' name="[TeamCurrentName]" role='dimension' type='nominal' />
            <column caption="Won batting first" datatype='real' default-format="p0%" name="[Calc_BatFirstWin]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 1 THEN [IsWin] END) / SUM(IF [BattedFirst] = 1 THEN [IsDecided] END)" />
            </column>
            <column caption="Matches batting first" datatype='real' default-format="n#,##0" name="[Calc_BatFirstN]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 1 THEN [IsDecided] END)" />
            </column>
            <column caption="Won chasing" datatype='real' default-format="p0%" name="[Calc_ChaseWin]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsWin] END) / SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
            </column>
            <column caption="Matches chasing" datatype='real' default-format="n#,##0" name="[Calc_ChaseN]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF [BattedFirst] = 0 THEN [IsDecided] END)" />
            </column>
            <column caption="Toss call" datatype='string' name="[Calc_TossCall]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF [Calc_BatFirstWin] &gt; [Calc_ChaseWin] THEN 'bat first' ELSEIF [Calc_ChaseWin] &gt; [Calc_BatFirstWin] THEN 'field and chase' ELSE 'either' END" />
            </column>
            <column caption="Strength of the evidence" datatype='string' name="[Calc_CallSignal]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF ABS([Calc_BatFirstWin] - [Calc_ChaseWin]) &gt; 1.96 * SQRT([Calc_WinPct] * (1 - [Calc_WinPct]) * (1 / [Calc_BatFirstN] + 1 / [Calc_ChaseN])) THEN 'the gap is bigger than chance - a clear edge' ELSE 'the gap is within what chance gives at this sample size - a lean, not a rule' END" />
            </column>
            <column caption="Selected team" datatype='boolean' name="[Calc_SelTeam]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[TeamCurrentName] = [Parameters].[Select Team]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[TeamCurrentName]" derivation='None' name="[none:TeamCurrentName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_BatFirstWin]" derivation='User' name="[usr:Calc_BatFirstWin:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_BatFirstN]" derivation='User' name="[usr:Calc_BatFirstN:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChaseWin]" derivation='User' name="[usr:Calc_ChaseWin:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChaseN]" derivation='User' name="[usr:Calc_ChaseN:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_TossCall]" derivation='User' name="[usr:Calc_TossCall:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_CallSignal]" derivation='User' name="[usr:Calc_CallSignal:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SelTeam]" derivation='None' name="[none:Calc_SelTeam:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.teammatch].[none:Calc_SelTeam:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelTeam:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.teammatch].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.teammatch].[none:Calc_SelTeam:nk]</column>
            <column>[federated.teammatch].[none:Calc_SeasonSel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.teammatch].[none:TeamCurrentName:nk]' />
              <text column='[federated.teammatch].[usr:Calc_BatFirstWin:qk]' />
              <text column='[federated.teammatch].[usr:Calc_BatFirstN:qk]' />
              <text column='[federated.teammatch].[usr:Calc_ChaseWin:qk]' />
              <text column='[federated.teammatch].[usr:Calc_ChaseN:qk]' />
              <text column='[federated.teammatch].[usr:Calc_TossCall:nk]' />
              <text column='[federated.teammatch].[usr:Calc_CallSignal:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#F2A900' fontname='Tableau Semibold' fontsize='10'>▶ Insight   </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[none:TeamCurrentName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> won </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_BatFirstWin:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> batting first (</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_BatFirstN:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> matches) and </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_ChaseWin:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> chasing (</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_ChaseN:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>).  Toss call: </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_TossCall:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> - </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.teammatch].[usr:Calc_CallSignal:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>.</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
