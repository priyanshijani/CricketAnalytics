          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Wickets by season (label: economy)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Season" name='federated.playerseason' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.playercareer].[PlayerName]' caption="Player" datatype='string' name="[Select Player]" param-domain-type='list' role='measure' type='nominal' value='"Naveen Bhatt"'>
          <calculation class='tableau' formula='"Naveen Bhatt"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.playerseason'>
            <column datatype='integer' name="[Wickets]" role='measure' type='quantitative' />
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([RunsConceded]) * 6 / SUM([LegalBallsBowled])" />
            </column>
            <column datatype='integer' name="[LegalBallsBowled]" role='measure' type='quantitative' />
            <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
            </column>
            <column-instance column="[Wickets]" derivation='Sum' name="[sum:Wickets:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_Economy]" derivation='User' name="[usr:Calc_Economy:qk]" pivot='key' type='quantitative' />
            <column-instance column="[LegalBallsBowled]" derivation='Sum' name="[sum:LegalBallsBowled:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelPlayer]" derivation='None' name="[none:Calc_SelPlayer:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerseason].[none:Calc_SelPlayer:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelPlayer:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.playerseason].[none:Calc_SelPlayer:nk]</column>
