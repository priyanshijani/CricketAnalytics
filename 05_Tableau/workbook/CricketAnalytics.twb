    <worksheet name="Player Bowling by Phase">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Economy by phase (line = league average; lower is better)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Phase" name='federated.playerphase' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.playercareer].[PlayerName]' caption="Player" datatype='string' name="[Select Player]" param-domain-type='list' role='measure' type='nominal' value='"Naveen Bhatt"'>
          <calculation class='tableau' formula='"Naveen Bhatt"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.playerphase'>
            <column caption="Phase" datatype='string' name="[Calc_Phase]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="CASE [Phase] WHEN 'Powerplay' THEN '1 Powerplay (overs 1-6)' WHEN 'Middle' THEN '2 Middle (7-15)' ELSE '3 Death (16-20)' END" />
            </column>
            <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) * 6 / SUM([Balls])" />
            </column>
            <column caption="League economy in the phase" datatype='real' default-format="n#,##0.00" name="[Calc_LeaguePhaseEcon]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="{FIXED [Phase], [Discipline] : SUM([Runs])} * 6 / {FIXED [Phase], [Discipline] : SUM([Balls])}" />
            </column>
            <column caption="Balls" datatype='integer' name="[Balls]" role='measure' type='quantitative' />
            <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column datatype='string' name="[Discipline]" role='dimension' type='nominal' />
            <column-instance column="[Calc_Phase]" derivation='None' name="[none:Calc_Phase:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_Economy]" derivation='User' name="[usr:Calc_Economy:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_LeaguePhaseEcon]" derivation='Avg' name="[avg:Calc_LeaguePhaseEcon:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Balls]" derivation='Sum' name="[sum:Balls:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelPlayer]" derivation='None' name="[none:Calc_SelPlayer:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
            <column-instance column="[Discipline]" derivation='None' name="[none:Discipline:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerphase].[none:Calc_SelPlayer:nk]'>
            <groupfilter function='member' level='[none:Calc_SelPlayer:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:Discipline:nk]'>
            <groupfilter function='member' level='[none:Discipline:nk]' member='"Bowling"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.playerphase].[none:Calc_SelPlayer:nk]</column>
            <column>[federated.playerphase].[none:Calc_SeasonSel:nk]</column>
            <column>[federated.playerphase].[none:Discipline:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='refline'>
            <format attr='stroke-color' id='refline0' value='#6B7785' />
            <format attr='color' id='refline0' value='#6B7785' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.playerphase].[usr:Calc_Economy:qk]' />
              <lod column='[federated.playerphase].[avg:Calc_LeaguePhaseEcon:qk]' />
              <tooltip column='[federated.playerphase].[sum:Balls:qk]' />
            </encodings>
            <reference-line axis-column='[federated.playerphase].[usr:Calc_Economy:qk]' enable-instant-analytics='false' formula='average' id='refline0' label-type='none' scope='per-pane' value-column='[federated.playerphase].[avg:Calc_LeaguePhaseEcon:qk]' z-order='1' />
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerphase].[none:Calc_Phase:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;Economy </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[usr:Calc_Economy:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> from </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[sum:Balls:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> balls; league </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[avg:Calc_LeaguePhaseEcon:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.playerphase].[none:Calc_Phase:nk]</rows>
        <cols>[federated.playerphase].[usr:Calc_Economy:qk]</cols>
      </table>
