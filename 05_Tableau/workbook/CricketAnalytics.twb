    <worksheet name="Opening Partnerships">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Opening pairs with 3+ innings (colour = how often the team won)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Partnership" name='federated.partnership' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.teammatch].[TeamCurrentName]' caption="Team" datatype='string' name="[Select Team]" param-domain-type='list' role='measure' type='nominal' value='"Bangalore Royals"'>
          <calculation class='tableau' formula='"Bangalore Royals"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.partnership'>
            <column caption="Opening pair" datatype='string' name="[Pair]" role='dimension' type='nominal' />
            <column caption="Partnership runs" datatype='integer' name="[RunsAdded]" role='measure' type='quantitative' />
            <column caption="Team won %" datatype='real' default-format="p0%" name="[Calc_TeamWonPct]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="AVG([TeamWon])" />
            </column>
            <column caption="Selected team" datatype='boolean' name="[Calc_SelTeam]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[BattingTeamCurrentName] = [Parameters].[Select Team]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column datatype='integer' name="[IsOpeningPartnership]" role='measure' type='quantitative' />
            <column-instance column="[Pair]" derivation='None' name="[none:Pair:nk]" pivot='key' type='nominal' />
            <column-instance column="[RunsAdded]" derivation='Count' name="[cnt:RunsAdded:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_TeamWonPct]" derivation='User' name="[usr:Calc_TeamWonPct:qk]" pivot='key' type='quantitative' />
            <column-instance column="[RunsAdded]" derivation='Avg' name="[avg:RunsAdded:qk]" pivot='key' type='quantitative' />
            <column-instance column="[RunsAdded]" derivation='Sum' name="[sum:RunsAdded:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelTeam]" derivation='None' name="[none:Calc_SelTeam:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
            <column-instance column="[IsOpeningPartnership]" derivation='None' name="[none:IsOpeningPartnership:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.partnership].[none:Calc_SelTeam:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelTeam:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.partnership].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.partnership].[none:IsOpeningPartnership:qk]' included-values='in-range'>
            <min>1</min>
          </filter>
          <filter class='quantitative' column='[federated.partnership].[cnt:RunsAdded:qk]' included-values='in-range'>
            <min>3</min>
          </filter>
          <computed-sort column='[federated.partnership].[none:Pair:nk]' direction='DESC' using='[federated.partnership].[cnt:RunsAdded:qk]' />
          <slices>
            <column>[federated.partnership].[none:Calc_SelTeam:nk]</column>
            <column>[federated.partnership].[none:Calc_SeasonSel:nk]</column>
            <column>[federated.partnership].[none:IsOpeningPartnership:qk]</column>
            <column>[federated.partnership].[cnt:RunsAdded:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.partnership].[avg:RunsAdded:qk]' value="n#,##0.0" />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.partnership].[usr:Calc_TeamWonPct:qk]' palette='GPL Diverging' type='interpolated' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.partnership].[usr:Calc_TeamWonPct:qk]' />
              <text column='[federated.partnership].[cnt:RunsAdded:qk]' />
              <text column='[federated.partnership].[avg:RunsAdded:qk]' />
              <tooltip column='[federated.partnership].[sum:RunsAdded:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.partnership].[none:Pair:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;• </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.partnership].[cnt:RunsAdded:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> innings together, </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.partnership].[sum:RunsAdded:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> runs; the team won </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.partnership].[usr:Calc_TeamWonPct:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> of those matches</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
