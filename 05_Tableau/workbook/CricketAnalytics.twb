            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.match].[none:Season:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;• </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.match].[sum:Calc_CloseFinish:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> of </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.match].[cnt:Calc_CloseFinish:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> decided matches were close (</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.match].[usr:Calc_ClosePct:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>)</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.match].[usr:Calc_ClosePct:qk]</rows>
        <cols>[federated.match].[none:Season:nk]</cols>
      </table>
