    <worksheet name="Why Rows Did Not Pass">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Why rows did not pass (flagged rows were loaded with a warning)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="DQ Row Outcome" name='federated.dqrowoutcome' />
          </datasources>
          <datasource-dependencies datasource='federated.dqrowoutcome'>
            <column caption="Outcome" datatype='string' name="[Outcome]" role='dimension' type='nominal' />
            <column datatype='integer' name="[Rows]" role='measure' type='quantitative' />
            <column caption="Entity" datatype='string' name="[EntityType]" role='dimension' type='nominal' />
            <column datatype='integer' name="[IsCurrent]" role='dimension' type='ordinal' />
            <column-instance column="[Outcome]" derivation='None' name="[none:Outcome:nk]" pivot='key' type='nominal' />
            <column-instance column="[Rows]" derivation='Sum' name="[sum:Rows:qk]" pivot='key' type='quantitative' />
            <column-instance column="[EntityType]" derivation='None' name="[none:EntityType:nk]" pivot='key' type='nominal' />
            <column-instance column="[IsCurrent]" derivation='None' name="[none:IsCurrent:ok]" pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.dqrowoutcome].[none:IsCurrent:ok]'>
            <groupfilter function='member' level='[none:IsCurrent:ok]' member='1' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.dqrowoutcome].[none:Outcome:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:Outcome:nk]' member='"Bad record"' /><groupfilter function='member' level='[none:Outcome:nk]' member='"Duplicate file"' /><groupfilter function='member' level='[none:Outcome:nk]' member='"Parent rejected"' /><groupfilter function='member' level='[none:Outcome:nk]' member='"Held: match incomplete"' /><groupfilter function='member' level='[none:Outcome:nk]' member='"Flagged (loaded with a warning)"' /></groupfilter>
          </filter>
          <computed-sort column='[federated.dqrowoutcome].[none:Outcome:nk]' direction='DESC' using='[federated.dqrowoutcome].[sum:Rows:qk]' />
          <slices>
            <column>[federated.dqrowoutcome].[none:IsCurrent:ok]</column>
            <column>[federated.dqrowoutcome].[none:Outcome:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
