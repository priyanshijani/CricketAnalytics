    <worksheet name="Insight Player">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Season" name='federated.playerseason' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.playercareer].[PlayerName]' caption="Player" datatype='string' name="[Select Player]" param-domain-type='list' role='measure' type='nominal' value='"Naveen Bhatt"'>
          <calculation class='tableau' formula='"Naveen Bhatt"' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.seasonlist].[Season]' caption="Season" datatype='string' name="[Select Season]" param-domain-type='list' role='measure' type='nominal' value='"All seasons"'>
          <calculation class='tableau' formula='"All seasons"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.playerseason'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) * 100 / SUM([BallsFaced])" />
            </column>
            <column caption="League strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_LeagueSR]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="{FIXED : SUM([Runs])} * 100 / {FIXED : SUM([BallsFaced])}" />
            </column>
            <column caption="Batting average" datatype='real' default-format="n#,##0.0" name="[Calc_BatAvg]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) / SUM([Dismissals])" />
            </column>
            <column caption="League batting average" datatype='real' default-format="n#,##0.0" name="[Calc_LeagueAvg]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="{FIXED : SUM([Runs])} / {FIXED : SUM([Dismissals])}" />
            </column>
            <column caption="Batting verdict" datatype='string' name="[Calc_BatVerdict]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF [Calc_StrikeRate] &gt;= MIN([Calc_LeagueSR]) AND [Calc_BatAvg] &gt;= MIN([Calc_LeagueAvg]) THEN 'Above the league on both pace and output.' ELSEIF [Calc_StrikeRate] &gt;= MIN([Calc_LeagueSR]) THEN 'Scores faster than the league but gets out sooner.' ELSEIF [Calc_BatAvg] &gt;= MIN([Calc_LeagueAvg]) THEN 'Reliable, but scores slower than the league.' ELSE 'Below the league average as a batter.' END" />
            </column>
            <column caption="Selected player" datatype='boolean' name="[Calc_SelPlayer]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[PlayerName] = [Parameters].[Select Player]" />
            </column>
            <column caption="In selected season" datatype='boolean' name="[Calc_SeasonSel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="([Parameters].[Select Season] = 'All seasons' OR [Season] = [Parameters].[Select Season])" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_StrikeRate]" derivation='User' name="[usr:Calc_StrikeRate:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_LeagueSR]" derivation='Min' name="[min:Calc_LeagueSR:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_BatAvg]" derivation='User' name="[usr:Calc_BatAvg:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_LeagueAvg]" derivation='Min' name="[min:Calc_LeagueAvg:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_BatVerdict]" derivation='User' name="[usr:Calc_BatVerdict:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SelPlayer]" derivation='None' name="[none:Calc_SelPlayer:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SeasonSel]" derivation='None' name="[none:Calc_SeasonSel:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerseason].[none:Calc_SelPlayer:nk]'>
            <groupfilter function='member' level='[none:Calc_SelPlayer:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerseason].[none:Calc_SeasonSel:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SeasonSel:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.playerseason].[none:Calc_SelPlayer:nk]</column>
            <column>[federated.playerseason].[none:Calc_SeasonSel:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.playerseason].[none:PlayerName:nk]' />
              <text column='[federated.playerseason].[usr:Calc_StrikeRate:qk]' />
              <text column='[federated.playerseason].[min:Calc_LeagueSR:qk]' />
              <text column='[federated.playerseason].[usr:Calc_BatAvg:qk]' />
              <text column='[federated.playerseason].[min:Calc_LeagueAvg:qk]' />
              <text column='[federated.playerseason].[usr:Calc_BatVerdict:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#F2A900' fontname='Tableau Semibold' fontsize='10'>▶ Insight   </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[none:PlayerName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>: strike rate </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[usr:Calc_StrikeRate:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> vs league </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.playerseason].[min:Calc_LeagueSR:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>, average </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[usr:Calc_BatAvg:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'> vs </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>&lt;[federated.playerseason].[min:Calc_LeagueAvg:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='10'>.  </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[usr:Calc_BatVerdict:nk]&gt;</run>
              </formatted-text>
