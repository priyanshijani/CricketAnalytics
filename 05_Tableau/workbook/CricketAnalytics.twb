          <datasource-dependencies datasource='federated.playercareer'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Role" datatype='string' name="[PlayerRole]" role='dimension' type='nominal' />
            <column caption="Impact per match" datatype='real' default-format="n#,##0.0" name="[ImpactPerMatch]" role='measure' type='quantitative' />
            <column datatype='integer' name="[ImpactRank]" role='dimension' type='ordinal' />
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[PlayerRole]" derivation='None' name="[none:PlayerRole:nk]" pivot='key' type='nominal' />
            <column-instance column="[ImpactPerMatch]" derivation='Avg' name="[avg:ImpactPerMatch:qk]" pivot='key' type='quantitative' />
            <column-instance column="[ImpactRank]" derivation='None' name="[none:ImpactRank:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.playercareer].[none:ImpactRank:qk]' included-values='in-range'>
            <max>1</max>
          </filter>
          <slices>
            <column>[federated.playercareer].[none:ImpactRank:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
