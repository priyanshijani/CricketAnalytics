          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.match].[MatchLabel]' caption="Match" datatype='string' name="[Select Match]" param-domain-type='list' role='measure' type='nominal' value='"M0120 | 2025-06-18 | MUM v DEL"'>
          <calculation class='tableau' formula='"M0120 | 2025-06-18 | MUM v DEL"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.battinginnings'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Team" datatype='string' name="[TeamName]" role='dimension' type='nominal' />
            <column caption="Runs" datatype='integer' name="[RunsScored]" role='measure' type='quantitative' />
            <column caption="Balls" datatype='integer' name="[BallsFaced]" role='measure' type='quantitative' />
            <column caption="Selected match" datatype='boolean' name="[Calc_SelMatch]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[MatchId] = SPLIT([Parameters].[Select Match], ' | ', 1)" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[TeamName]" derivation='None' name="[none:TeamName:nk]" pivot='key' type='nominal' />
            <column-instance column="[RunsScored]" derivation='Sum' name="[sum:RunsScored:qk]" pivot='key' type='quantitative' />
            <column-instance column="[BallsFaced]" derivation='Sum' name="[sum:BallsFaced:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_SelMatch]" derivation='None' name="[none:Calc_SelMatch:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.battinginnings].[none:Calc_SelMatch:nk]' context='true'>
            <groupfilter function='member' level='[none:Calc_SelMatch:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.battinginnings].[none:PlayerName:nk]'>
            <groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression="[Calc_RankRuns]" function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:PlayerName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
