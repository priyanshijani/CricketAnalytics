    <worksheet name="Death-Over Strike Rate">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Best death-over strike rates, top 15 (min 30 balls; line = league)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Phase" name='federated.playerphase' />
          </datasources>
          <datasource-dependencies datasource='federated.playerphase'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Strike rate" datatype='real' default-format="n#,##0.0" name="[Calc_StrikeRate]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) * 100 / SUM([Balls])" />
            </column>
            <column caption="League strike rate in the phase" datatype='real' default-format="n#,##0.0" name="[Calc_LeaguePhaseSR]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="{FIXED [Phase], [Discipline] : SUM([Runs])} * 100 / {FIXED [Phase], [Discipline] : SUM([Balls])}" />
            </column>
            <column caption="Balls" datatype='integer' name="[Balls]" role='measure' type='quantitative' />
            <column datatype='string' name="[Phase]" role='dimension' type='nominal' />
            <column datatype='string' name="[Discipline]" role='dimension' type='nominal' />
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_StrikeRate]" derivation='User' name="[usr:Calc_StrikeRate:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_LeaguePhaseSR]" derivation='Avg' name="[avg:Calc_LeaguePhaseSR:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Balls]" derivation='Sum' name="[sum:Balls:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Phase]" derivation='None' name="[none:Phase:nk]" pivot='key' type='nominal' />
            <column-instance column="[Discipline]" derivation='None' name="[none:Discipline:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerphase].[none:Phase:nk]' context='true'>
            <groupfilter function='member' level='[none:Phase:nk]' member='"Death"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:Discipline:nk]' context='true'>
            <groupfilter function='member' level='[none:Discipline:nk]' member='"Batting"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:PlayerName:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression="[Calc_RankDeathSR]" function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:PlayerName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.playerphase].[none:PlayerName:nk]' direction='DESC' using='[federated.playerphase].[usr:Calc_StrikeRate:qk]' />
          <slices>
            <column>[federated.playerphase].[none:Phase:nk]</column>
            <column>[federated.playerphase].[none:Discipline:nk]</column>
            <column>[federated.playerphase].[none:PlayerName:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
          <style-rule element='refline'>
            <format attr='stroke-color' id='refline0' value='#6B7785' />
            <format attr='color' id='refline0' value='#6B7785' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.playerphase].[usr:Calc_StrikeRate:qk]' />
              <lod column='[federated.playerphase].[avg:Calc_LeaguePhaseSR:qk]' />
              <tooltip column='[federated.playerphase].[sum:Balls:qk]' />
            </encodings>
            <reference-line axis-column='[federated.playerphase].[usr:Calc_StrikeRate:qk]' enable-instant-analytics='false' formula='average' id='refline0' label-type='none' scope='per-table' value-column='[federated.playerphase].[avg:Calc_LeaguePhaseSR:qk]' z-order='1' />
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerphase].[none:PlayerName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;Death-over strike rate </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[usr:Calc_StrikeRate:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> from </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[sum:Balls:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> balls</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-color' value='#1F4E79' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.playerphase].[none:PlayerName:nk]</rows>
        <cols>[federated.playerphase].[usr:Calc_StrikeRate:qk]</cols>
      </table>
      <simple-id uuid='{74AB7B66-5D07-55D7-854A-E3E597CA69AA}' />
    </worksheet>
    <worksheet name="Powerplay vs Death Economy">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>The 15 most economical death bowlers: powerplay vs death economy</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Phase" name='federated.playerphase' />
          </datasources>
          <datasource-dependencies datasource='federated.playerphase'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Economy" datatype='real' default-format="n#,##0.00" name="[Calc_Economy]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([Runs]) * 6 / SUM([Balls])" />
            </column>
            <column caption="Phase" datatype='string' name="[Calc_Phase]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="CASE [Phase] WHEN 'Powerplay' THEN '1 Powerplay (overs 1-6)' WHEN 'Middle' THEN '2 Middle (7-15)' ELSE '3 Death (16-20)' END" />
            </column>
            <column caption="Balls" datatype='integer' name="[Balls]" role='measure' type='quantitative' />
            <column datatype='string' name="[Phase]" role='dimension' type='nominal' />
            <column datatype='string' name="[Discipline]" role='dimension' type='nominal' />
            <column caption="Death economy (min 60 balls)" datatype='real' name="[Calc_RankDeathEcon]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="IF SUM([Calc_DeathBalls]) &gt;= 60 THEN SUM([Calc_DeathRuns]) * 6 / SUM([Calc_DeathBalls]) ELSE 99 END" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_Economy]" derivation='User' name="[usr:Calc_Economy:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_Phase]" derivation='None' name="[none:Calc_Phase:nk]" pivot='key' type='nominal' />
            <column-instance column="[Balls]" derivation='Sum' name="[sum:Balls:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Phase]" derivation='None' name="[none:Phase:nk]" pivot='key' type='nominal' />
            <column-instance column="[Discipline]" derivation='None' name="[none:Discipline:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_RankDeathEcon]" derivation='User' name="[usr:Calc_RankDeathEcon:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerphase].[none:Phase:nk]' context='true'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:Phase:nk]' member='"Powerplay"' /><groupfilter function='member' level='[none:Phase:nk]' member='"Death"' /></groupfilter>
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:Discipline:nk]' context='true'>
            <groupfilter function='member' level='[none:Discipline:nk]' member='"Bowling"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.playerphase].[none:PlayerName:nk]'>
            <groupfilter count='15' end='bottom' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression="[Calc_RankDeathEcon]" function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:PlayerName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.playerphase].[none:PlayerName:nk]' direction='ASC' using='[federated.playerphase].[usr:Calc_RankDeathEcon:qk]' />
          <slices>
            <column>[federated.playerphase].[none:Phase:nk]</column>
            <column>[federated.playerphase].[none:Discipline:nk]</column>
            <column>[federated.playerphase].[none:PlayerName:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.playerphase].[none:Calc_Phase:nk]' />
              <tooltip column='[federated.playerphase].[sum:Balls:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerphase].[none:PlayerName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;• </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[none:Calc_Phase:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>: economy </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[usr:Calc_Economy:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> from </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerphase].[sum:Balls:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> balls</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='size' value='1.5' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.playerphase].[none:PlayerName:nk]</rows>
        <cols>[federated.playerphase].[usr:Calc_Economy:qk]</cols>
      </table>
      <simple-id uuid='{B2428183-952E-5105-BFDB-BBE330876A09}' />
    </worksheet>
    <worksheet name="Improving and Declining">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Runs vs the previous season (changes of 100+ runs)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player Season" name='federated.playerseason' />
          </datasources>
          <datasource-dependencies datasource='federated.playerseason'>
            <column caption="Player" datatype='string' name="[PlayerName]" role='dimension' type='nominal' />
            <column caption="Runs vs previous season" datatype='integer' name="[RunsChangeVsPriorSeason]" role='measure' type='quantitative' />
            <column caption="Direction" datatype='string' name="[Calc_ChangeDirection]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [RunsChangeVsPriorSeason] &gt;= 0 THEN 'Improving' ELSE 'Declining' END" />
            </column>
            <column datatype='integer' name="[Runs]" role='measure' type='quantitative' />
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="Size of change in runs" datatype='integer' name="[Calc_AbsRunsChange]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="ABS([RunsChangeVsPriorSeason])" />
            </column>
            <column-instance column="[PlayerName]" derivation='None' name="[none:PlayerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[RunsChangeVsPriorSeason]" derivation='Sum' name="[sum:RunsChangeVsPriorSeason:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Calc_ChangeDirection]" derivation='None' name="[none:Calc_ChangeDirection:nk]" pivot='key' type='nominal' />
            <column-instance column="[Runs]" derivation='Sum' name="[sum:Runs:qk]" pivot='key' type='quantitative' />
            <column-instance column="[Season]" derivation='Attribute' name="[attr:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_AbsRunsChange]" derivation='Sum' name="[sum:Calc_AbsRunsChange:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.playerseason].[none:Season:nk]' filter-group='11'>
            <groupfilter function='member' level='[none:Season:nk]' member='"2025"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.playerseason].[sum:Calc_AbsRunsChange:qk]' included-values='in-range'>
            <min>100</min>
          </filter>
          <computed-sort column='[federated.playerseason].[none:PlayerName:nk]' direction='DESC' using='[federated.playerseason].[sum:RunsChangeVsPriorSeason:qk]' />
          <slices>
            <column>[federated.playerseason].[none:Season:nk]</column>
            <column>[federated.playerseason].[sum:Calc_AbsRunsChange:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.playerseason].[none:Calc_ChangeDirection:nk]' />
              <text column='[federated.playerseason].[sum:RunsChangeVsPriorSeason:qk]' />
              <tooltip column='[federated.playerseason].[sum:Runs:qk]' />
              <tooltip column='[federated.playerseason].[attr:Season:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='10'>&lt;[federated.playerseason].[none:PlayerName:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&#10;• </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[sum:Runs:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> runs in </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[attr:Season:nk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>, </run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'>&lt;[federated.playerseason].[sum:RunsChangeVsPriorSeason:qk]&gt;</run>
                <run fontcolor='#24323F' fontname='Tableau Book' fontsize='9'> vs the season before</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.playerseason].[none:PlayerName:nk]</rows>
        <cols>[federated.playerseason].[sum:RunsChangeVsPriorSeason:qk]</cols>
      </table>
      <simple-id uuid='{3CCB87B5-858E-5F35-8984-68B2F5DAB925}' />
    </worksheet>
    <worksheet name="Match Summary">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Match" name='federated.match' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.match].[MatchLabel]' caption="Match" datatype='string' name="[Select Match]" param-domain-type='list' role='measure' type='nominal' value='"M0120 | 2025-06-18 | MUM v DEL"'>
          <calculation class='tableau' formula='"M0120 | 2025-06-18 | MUM v DEL"' />
        </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.match'>
            <column datatype='string' name="[MatchLabel]" role='dimension' type='nominal' />
            <column caption="Venue" datatype='string' name="[VenueName]" role='dimension' type='nominal' />
            <column datatype='string' name="[TossWinnerName]" role='dimension' type='nominal' />
            <column caption="Toss decision" datatype='string' name="[TossDecision]" role='dimension' type='nominal' />
            <column caption="Scores" datatype='string' name="[Calc_Scores]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[Team1Code] + ' ' + STR([Team1Runs]) + '/' + STR([Team1Wickets]) + '  v  ' + [Team2Code] + ' ' + STR([Team2Runs]) + '/' + STR([Team2Wickets])" />
            </column>
            <column caption="Result" datatype='string' name="[Calc_ResultText]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [ResultMethod] = 'Normal' THEN [WinnerName] + ' won by ' + STR([WinMargin]) + ' ' + LOWER([WinMarginType]) ELSEIF [ResultMethod] = 'SuperOver' THEN [WinnerName] + ' won the super over' ELSE [ResultMethod] END" />
            </column>
            <column datatype='string' name="[ManOfMatch]" role='dimension' type='nominal' />
            <column caption="Selected match" datatype='boolean' name="[Calc_SelMatch]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[MatchId] = SPLIT([Parameters].[Select Match], ' | ', 1)" />
            </column>
            <column-instance column="[MatchLabel]" derivation='None' name="[none:MatchLabel:nk]" pivot='key' type='nominal' />
            <column-instance column="[VenueName]" derivation='None' name="[none:VenueName:nk]" pivot='key' type='nominal' />
            <column-instance column="[TossWinnerName]" derivation='None' name="[none:TossWinnerName:nk]" pivot='key' type='nominal' />
            <column-instance column="[TossDecision]" derivation='None' name="[none:TossDecision:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_Scores]" derivation='None' name="[none:Calc_Scores:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_ResultText]" derivation='None' name="[none:Calc_ResultText:nk]" pivot='key' type='nominal' />
            <column-instance column="[ManOfMatch]" derivation='None' name="[none:ManOfMatch:nk]" pivot='key' type='nominal' />
            <column-instance column="[Calc_SelMatch]" derivation='None' name="[none:Calc_SelMatch:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.match].[none:Calc_SelMatch:nk]'>
            <groupfilter function='member' level='[none:Calc_SelMatch:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.match].[none:Calc_SelMatch:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='axis-title'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value="Tableau Semibold" />
            <format attr='font-size' value="9" />
            <format attr='color' value="#6B7785" />
          </style-rule>
          <style-rule element='datalabel'>
            <format attr='font-family' value="Tableau Book" />
            <format attr='font-size' value="8" />
            <format attr='color' value="#24323F" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' scope='cols' value="off" />
            <format attr='line-visibility' scope='rows' value="off" />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='cols' value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.match].[none:MatchLabel:nk]' />
              <text column='[federated.match].[none:VenueName:nk]' />
              <text column='[federated.match].[none:TossWinnerName:nk]' />
              <text column='[federated.match].[none:TossDecision:nk]' />
              <text column='[federated.match].[none:Calc_Scores:nk]' />
              <text column='[federated.match].[none:Calc_ResultText:nk]' />
              <text column='[federated.match].[none:ManOfMatch:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='13'>&lt;[federated.match].[none:MatchLabel:nk]&gt;</run>
                <run fontcolor='#6B7785'>&#10;Venue  </run>
                <run>&lt;[federated.match].[none:VenueName:nk]&gt;</run>
                <run fontcolor='#6B7785'>&#10;Toss  </run>
                <run>&lt;[federated.match].[none:TossWinnerName:nk]&gt;</run>
                <run> chose to </run>
                <run>&lt;[federated.match].[none:TossDecision:nk]&gt;</run>
                <run fontcolor='#6B7785'>&#10;Score  </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold'>&lt;[federated.match].[none:Calc_Scores:nk]&gt;</run>
                <run fontcolor='#6B7785'>&#10;Result  </run>
                <run fontcolor='#1F4E79' fontname='Tableau Semibold'>&lt;[federated.match].[none:Calc_ResultText:nk]&gt;</run>
                <run fontcolor='#6B7785'>&#10;Player of the match  </run>
                <run>&lt;[federated.match].[none:ManOfMatch:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
