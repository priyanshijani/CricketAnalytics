    <worksheet name="Run Rate by Phase">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F4E79' fontname='Tableau Semibold' fontsize='11'>Runs per over by phase and season (darker = faster scoring)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Over Progression" name='federated.overprogression' />
          </datasources>
          <datasource-dependencies datasource='federated.overprogression'>
            <column caption="Phase" datatype='string' name="[Calc_Phase]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="CASE [Phase] WHEN 'Powerplay' THEN '1 Powerplay (overs 1-6)' WHEN 'Middle' THEN '2 Middle (7-15)' ELSE '3 Death (16-20)' END" />
            </column>
            <column datatype='string' name="[Season]" role='dimension' type='nominal' />
            <column caption="Runs in the over" datatype='integer' name="[RunsInOver]" role='measure' type='quantitative' />
            <column-instance column="[Calc_Phase]" derivation='None' name="[none:Calc_Phase:nk]" pivot='key' type='nominal' />
            <column-instance column="[Season]" derivation='None' name="[none:Season:nk]" pivot='key' type='nominal' />
            <column-instance column="[RunsInOver]" derivation='Avg' name="[avg:RunsInOver:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
