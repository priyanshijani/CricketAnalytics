<Node ToolID="7">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="75" y="259" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File />
          <FormatSpecificOptions UseDcm="true" Format="23" RecordLimit="">
            <SingleRowFetch>False</SingleRowFetch>
            <ReadCentroids>False</ReadCentroids>
            <Query>SELECT MatchId, MatchDate, FormatCode, VenueCode, Team1Code, Team2Code, Team1Name, Team2Name, TossWinnerCode, TossDecision,
  WinnerCode, ResultMethod, WinMargin, WinMarginType, ManOfMatchCode, Season, FileStatus, RTRIM(SourceFileHash) AS SourceFileHash
FROM (SELECT v.*, ROW_NUMBER() OVER (PARTITION BY v.MatchId ORDER BY v.LoadRunId DESC) AS rn FROM stg.MatchValid AS v) AS x WHERE rn = 1</Query>
            <TableStyle>Quoted</TableStyle>
            <PostSQL />
            <CacheData>False</CacheData>
            <Table />
            <SessionReadOnly>True</SessionReadOnly>
            <ReadUncommitted>False</ReadUncommitted>
            <Connection DcmType="ConnectionId" DcmTitle="CricketDW_DSN" DcmSchemaId="database-odbc-dsn-mssql-nocreds">f2959105-04cd-4379-a3c1-64baa7fb78b9</Connection>
            <NoProgress>True</NoProgress>
            <PreSQLOnConfig>True</PreSQLOnConfig>
            <PreSQL />
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <AnnotationText>Match headers - latest version of each match in the queue (a correction supersedes the original)</AnnotationText>
          <DefaultAnnotationText />
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
<Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="75" y="419" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File />
          <FormatSpecificOptions UseDcm="true" Format="23" RecordLimit="">
            <SingleRowFetch>False</SingleRowFetch>
            <ReadCentroids>False</ReadCentroids>
            <Query>SELECT i.MatchId, i.InningsNo, i.BattingTeamCode, i.BowlingTeamCode, i.RunsScored, i.WicketsLost, i.OversPlayed, i.ExtrasTotal
FROM stg.InningsValid AS i JOIN (SELECT MatchId, MAX(LoadRunId) AS LatestRun FROM stg.MatchValid GROUP BY MatchId) AS m ON m.MatchId = i.MatchId AND m.LatestRun = i.LoadRunId</Query>
            <TableStyle>Quoted</TableStyle>
            <PostSQL />
            <CacheData>False</CacheData>
            <Table />
            <SessionReadOnly>True</SessionReadOnly>
            <ReadUncommitted>False</ReadUncommitted>
            <Connection DcmType="ConnectionId" DcmTitle="CricketDW_DSN" DcmSchemaId="database-odbc-dsn-mssql-nocreds">f2959105-04cd-4379-a3c1-64baa7fb78b9</Connection>
            <NoProgress>True</NoProgress>
            <PreSQLOnConfig>True</PreSQLOnConfig>
            <PreSQL />
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <AnnotationText>Innings of that same match version</AnnotationText>
          <DefaultAnnotationText />
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
