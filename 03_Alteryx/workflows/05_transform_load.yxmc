<Node ToolID="10">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="75" y="648" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File />
          <FormatSpecificOptions UseDcm="true" Format="23" RecordLimit="">
            <SingleRowFetch>False</SingleRowFetch>
            <ReadCentroids>False</ReadCentroids>
            <Query>SELECT m.MatchId,
  (SELECT TOP (1) c.InningsStatus FROM stg.MatchCompletenessValid AS c WHERE c.MatchId = m.MatchId AND c.InningsStatus IS NOT NULL ORDER BY c.LoadRunId DESC) AS InningsStatus,
  (SELECT TOP (1) c.BallByBallStatus FROM stg.MatchCompletenessValid AS c WHERE c.MatchId = m.MatchId AND c.BallByBallStatus IS NOT NULL ORDER BY c.LoadRunId DESC) AS BallByBallStatus
FROM (SELECT DISTINCT MatchId FROM stg.MatchCompletenessValid) AS m</Query>
            <TableStyle>Quoted</TableStyle>
            <PostSQL />
            <CacheData>False</CacheData>
